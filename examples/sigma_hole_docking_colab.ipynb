   "source": [
    "import re\n",
    "def extract_vmax_from_txt(txt_path):\n",
    "    \"\"\"Return the largest Vmax (kcal/mol) from a *_surfanalysis.txt file.\"\"\"\n",
    "    with open(txt_path, 'r', encoding='utf-8') as f:\n",
    "        lines = f.readlines()\n",
    "    # Locate the line that starts with 'Number of surface maxima:'\n",
    "    for i, line in enumerate(lines):\n",
    "        if line.strip().startswith('Number of surface maxima:'):\n",
    "            # Move to the next line\n",
    "            j = i + 1\n",
    "            # Skip any blank lines\n",
    "            while j < len(lines) and lines[j].strip() == '':\n",
    "                j += 1\n",
    "            vmax_vals = []\n",
    "            # Read until a blank line or end of file\n",
    "            while j < len(lines) and lines[j].strip() != '':\n",
    "                l = lines[j].strip()\n",
    "                # Remove a leading asterisk if present (marks the maximum)\n",
    "                if l.startswith('*'):\n",
    "                    l = l[1:].strip()\n",
    "                # Split by whitespace\n",
    "                parts = l.split()\n",
    "                # Expect at least: # a.u. eV kcal/mol X Y Z ...\n",
    "                if len(parts) >= 4:\n",
    "                    try:\n",
    "                        val = float(parts[3])  # kcal/mol column\n",
    "                        vmax_vals.append(val)\n",
    "                    except ValueError:\n",
    "                        pass  # ignore non‑numeric lines\n",
    "                j += 1\n",
    "            if vmax_vals:\n",
    "                return max(vmax_vals)  # largest Vmax among maxima\n",
    "            else:\n",
    "                raise ValueError(f'No Vmax values found in maxima section of {txt_path}')\n",
    "    raise ValueError(f'Could not find maxima section in {txt_path}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "from rdkit import Chem\n",
    "\n",
    "def get_halogen_and_smiles_from_sdf(sdf_path):\n",
    "    \"\"\"Return (halogen_symbol, smiles) from an SDF file.\"\"\"\n",
    "    try:\n",
    "        mol = Chem.MolFromMolFile(sdf_path, removeHs=False)\n",
    "        if mol is None:\n",
    "            return None, None\n",
    "        smiles = Chem.MolToSmiles(mol)\n",
    "        # Find halogen atoms (F, Cl, Br, I, At)\n",
    "        halogen_set = {9: 'F', 17: 'Cl', 35: 'Br', 53: 'I', 85: 'At'}\n",
    "        halogen_symbols = []\n",
    "        for atom in mol.GetAtoms():\n",
    "            z = atom.GetAtomicNum()\n",
    "            if z in halogen_set:\n",
    "                halogen_symbols.append(halogen_set[z])\n",
    "        # If we found exactly one halogen, return it; otherwise return first or None\n",
    "        if len(halogen_symbols) == 1:\n",
    "            return halogen_symbols[0], smiles\n",
    "        elif len(halogen_symbols) > 1:\n",
    "            # For simplicity, return the first halogen found\n",
    "            return halogen_symbols[0], smiles\n",
    "        else:\n",
    "            return None, smiles\n",
    "    except Exception:\n",
    "        return None, None\n",
    "\n",
    "def make_csv_from_mo_files():\n",
    "    \"\"\"Scan the directory for *_surfanalysis.txt files and return a DataFrame ready for the pipeline.\"\"\"\n",
    "    records = []\n",
    "    for fname in os.listdir('.'):\n",
    "        if fname.endswith('_surfanalysis.txt'):\n",
    "            compound = fname.replace('_surfanalysis.txt', '')\n",
    "            try:\n",
    "                vmax = extract_vmax_from_txt(fname)\n",
    "            except Exception as e:\n",
    "                print(f'⚠️  Skipping {fname}: {e}')\n",
    "                continue\n",
    "            # Look for corresponding SDF file\n",
    "            sdf_fname = compound + '.sdf'\n",
    "            halogen = ''\n",
    "            smiles = ''\n",
    "            if os.path.exists(sdf_fname):\n",
    "                hal, smi = get_halogen_and_smiles_from_sdf(sdf_fname)\n",
    "                if hal is not None:\n",
    "                    halogen = hal\n",
    "                if smi is not None:\n",
    "                    smiles = smi\n",
    "                else:\n",
    "                    print(f'⚠️  Could not generate SMILES from {sdf_fname}')\n",
    "            else:\n",
    "                print(f'⚠️  No SDF file found for {compound}; halogen and SMILES will be blank – please fill them manually.')\n",
    "            records.append({\n",
    "                'compound_id': compound,\n    "                'smiles': smiles,\n",
    "                'halogen': halogen,\n",
    "                'vmax': vmax\n",
    "            })\n",
    "    if not records:\n",
    "        return None\n",
    "    df = pd.DataFrame(records, columns=['compound_id','smiles','halogen','vmax'])\n",
    "    return df\n",
    "\n",
    "mo_df = make_csv_from_mo_files()\n",
    "if mo_df is not None:\n",
    "    print(f'Found {len(mo_df)} MO file(s). Generated preview:')\n",
    "    display(mo_df)\n",
    "    print('\\nIf any halogen or SMILES fields are blank, please edit the variable `mo_df` directly (or upload your own CSV).')\n",
    "else:\n",
    "    print('No *_surfanalysis.txt files found – you will need to upload your own input CSV.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# If you have a DataFrame from the previous cell (mo_df), you can edit it here.\n",
    "# Otherwise, upload a CSV now.\n",
    "if 'mo_df' in locals() and mo_df is not None:\n",
    "    print('DataFrame preview (you can edit the variable `mo_df` directly if needed):')\n",
    "    display(mo_df)\n",
    "    print('\\nEdit the `smiles` and `halogen` columns in the variable `mo_df` above as needed, then run the next cell to save the CSV.')\n",
    "else:\n",
    "    print('Please upload your input CSV now (columns: compound_id,smiles,halogen,vmax).')\n",
    "    uploaded2 = files.upload()\n",
    "    for name in uploaded2.keys():\n",
    "        if name.endswith('.csv'):\n",
    "            print(f'Uploaded CSV: {name}')\n",
    "            edited_df = pd.read_csv(name)\n",
    "            break\n",
    "    else:\n",
    "        raise FileNotFoundError('No CSV file was uploaded.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the (possibly edited) dataframe as the input CSV for the pipeline\n",
    "# Determine which dataframe to use\n",
    "if 'mo_df' in locals() and mo_df is not None:\n",
    "    df_to_save = mo_df\n",
    "    df_name = 'mo_df'\n",
    "elif 'edited_df' in locals():\n",
    "    df_to_save = edited_df\n",
    "    df_name = 'edited_df'\n",
    "else:\n",
    "    raise RuntimeError('No dataframe found to save.')\n",
    "\n",
    "csv_path = 'input_from_upload.csv'\n",
    "df_to_save.to_csv(csv_path, index=False)\n",
    "print(f'Saved input CSV to `{csv_path}` from {df_name} with {len(df_to_save)} rows.')\n",
    "print(df_to_save.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Upload a receptor file (PDBQT) if you want to override the default.')\n",
    "receptor_upload = files.upload()\n",
    "receptor_path = 'receptor.pdbqt'  # default\n",
    "if receptor_upload:\n",
    "    # Assume the first uploaded file is the receptor\n",
    "    uploaded_name = list(receptor_upload.keys())[0]\n",
    "    receptor_path = uploaded_name\n",
    "    print(f'Using uploaded receptor: {receptor_path}')\n",
    "elif os.path.exists(receptor_path):\n",
    "    print(f'Using existing receptor: {receptor_path}')\n",
    "else:\n",
    "    print(f'⚠️  No receptor file found at {receptor_path}. Please upload one.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Make sure the current directory is on Python path so we can import sigma_hole_pipeline\n",
    "import sys\n",
    "if '.' not in sys.path:\n",
    "    sys.path.insert(0, '.')\n",
    "\n",
    "from sigma_hole_pipeline import SigmaHolePipeline\n",
    "\n",
    "# Paths – adjust if you used different names\n",
    "input_csv = 'input_from_upload.csv'   # from previous step\n",
    "receptor_input = receptor_path        # selected above\n",
    "structure_dir = '.'                   # look for ligand structures in the current folder\n",
    "structure_ext = '.sdf'                # change if you have .pdb or other formats\n",
    "\n",
    "print(f'Input CSV: {input_csv}')\n",
    "print(f'Receptor:   {receptor_input}')\n",
    "print(f'Structure dir: {structure_dir} (extension {structure_ext})')\n",
    "\n",
    "# Quick sanity check\n",
    "if not os.path.exists(input_csv):\n",
    "    raise FileNotFoundError(f'Input CSV not found: {input_csv}')\n",
    "if not os.path.exists(receptor_input):\n",
    "    raise FileNotFoundError(f'Receptor not found: {receptor_input}')\n",
    "\n",
    "pipeline = SigmaHolePipeline()\n",
    "print('Starting sigma‑hole pipeline...')\n",
    "results = pipeline.run_full_pipeline(\n",
    "    input_csv=input_csv,\n",
    "    receptor_input=receptor_input,\n",
    "    structure_dir=structure_dir,\n",
    "    structure_ext=structure_ext\n",
    ")\n",
    "print('Pipeline completed!')\n",
    "print(f'Result keys: {list(results.keys())}')\n"
   ]
  },
